</div>

<script>
// ============ DEFAULT SETTINGS ============
const DEFAULT = {
  name: 'Sayangku 💖',
  message: `Selamat ulang tahun, cintaku! 🎉
Semoga di hari spesialmu ini, semua impianmu terwujud.
Terima kasih sudah hadir di hidupku dan menjadi bagian terindah dari hariku.
Aku mencintaimu lebih dari yang bisa diungkapkan kata-kata. 💕`,
  photo: '',
  coverTitle: 'Ada sesuatu yang menantimu...',
  coverDesc: `Sebuah petualangan kecil sudah disiapkan.
Lewati rintangan, temukan rahasia, dan sampai di ujung perjalanan!
Seseorang meninggalkan ini khusus untukmu 💫`,
  enemyCount: 5,
  coinCount: 34,
  colorPrimary: '#ff6b9d',
  skyColor: '#5c94fc'
};

let settings = JSON.parse(JSON.stringify(DEFAULT));

// ============ GAME SETUP ============
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const W = canvas.width;
const H = canvas.height;

let gameState = {
  running: false,
  lives: 3,
  coins: 0,
  startTime: 0,
  elapsedTime: 0,
  cameraX: 0,
  gravity: 0.6,
  photoFound: false
};

const player = {
  x: 50, y: 250, w: 30, h: 38,
  vx: 0, vy: 0,
  onGround: false, facing: 1,
  speed: 4, jumpPower: -12.5,
  invulnerable: 0, animationFrame: 0
};

const keys = { left: false, right: false, jump: false, jumpPressed: false };

const LEVEL_WIDTH = 3600;

let platforms = [];
let coins = [];
let enemies = [];
let clouds = [];
let goal = null;
let secretWall = null;
let photoReward = null;

// ============ GENERATE LEVEL ============
function generateLevel() {
  platforms = [];
  coins = [];
  enemies = [];
  clouds = [];

  // Ground platforms
  const groundY = 340;
  const groundSegments = [
    [0, 900],
    [980, 1500],
    [1580, 2200],
    [2280, 2900],
    [2980, 3600]
  ];
  groundSegments.forEach(([sx, ex]) => {
    platforms.push({ x: sx, y: groundY, w: ex - sx, h: 60, type: 'ground' });
  });

  // Floating platforms
  const floatingPlatforms = [
    { x: 300, y: 260, w: 100, h: 20 },
    { x: 480, y: 200, w: 100, h: 20 },
    { x: 660, y: 250, w: 120, h: 20 },
    { x: 920, y: 280, w: 80, h: 20 },
    { x: 1050, y: 240, w: 100, h: 20 },
    { x: 1250, y: 200, w: 100, h: 20 },
    { x: 1420, y: 260, w: 100, h: 20 },
    { x: 1620, y: 180, w: 120, h: 20 },
    { x: 1850, y: 220, w: 100, h: 20 },
    { x: 2020, y: 160, w: 100, h: 20 },
    { x: 2250, y: 230, w: 100, h: 20 },
    { x: 2400, y: 180, w: 120, h: 20 },
    { x: 2620, y: 250, w: 100, h: 20 },
    { x: 2850, y: 200, w: 120, h: 20 },
    { x: 3050, y: 240, w: 120, h: 20 }
  ];
  floatingPlatforms.forEach(p => {
    platforms.push({ ...p, type: 'floating' });
  });

  // Tembok rahasia
  secretWall = {
    x: 2200,
    y: 220,
    w: 40,
    h: 120,
    destroyed: false,
    shake: 0
  };
  platforms.push({
    x: secretWall.x,
    y: secretWall.y,
    w: secretWall.w,
    h: secretWall.h,
    type: 'secret-wall',
    isSecret: true
  });

  // Foto reward
  photoReward = {
    x: secretWall.x + 5,
    y: secretWall.y + 20,
    w: 30,
    h: 30,
    collected: false,
    glow: 0
  };

  // Coins
  const baseCoinPositions = [
    [320, 220], [360, 220], [500, 160], [540, 160],
    [690, 210], [730, 210], [770, 210], [940, 240],
    [1080, 200], [1120, 200], [1280, 160], [1320, 160],
    [1450, 220], [1490, 220], [1650, 140], [1690, 140], [1730, 140],
    [1880, 180], [1920, 180], [2050, 120], [2090, 120],
    [2280, 190], [2320, 190], [2430, 140], [2470, 140],
    [2650, 210], [2690, 210], [2880, 160], [2920, 160],
    [3080, 200], [3120, 200]
  ];
  const targetCoins = Math.min(settings.coinCount, baseCoinPositions.length + 10);
  for (let i = 0; i < targetCoins && i < baseCoinPositions.length; i++) {
    coins.push({ x: baseCoinPositions[i][0], y: baseCoinPositions[i][1], w: 20, h: 20, collected: false, anim: Math.random() * Math.PI * 2 });
  }
  const groundCoins = [[200, 310], [600, 310], [1100, 310], [1600, 310], [2100, 310], [2600, 310], [3000, 310], [3300, 310]];
  groundCoins.forEach(([x, y]) => {
    if (coins.length < targetCoins) {
      coins.push({ x, y, w: 20, h: 20, collected: false, anim: Math.random() * Math.PI * 2 });
    }
  });

  // Enemies
  const allEnemies = [
    { x: 400, y: 310, minX: 350, maxX: 850 },
    { x: 1100, y: 310, minX: 1000, maxX: 1450 },
    { x: 1700, y: 310, minX: 1600, maxX: 2150 },
    { x: 2400, y: 310, minX: 2300, maxX: 2850 },
    { x: 3100, y: 310, minX: 3000, maxX: 3450 },
    { x: 600, y: 310, minX: 500, maxX: 850 },
    { x: 1300, y: 310, minX: 1200, maxX: 1450 },
    { x: 1900, y: 310, minX: 1800, maxX: 2150 },
    { x: 2700, y: 310, minX: 2600, maxX: 2850 },
    { x: 3300, y: 310, minX: 3200, maxX: 3500 }
  ];
  const enemyCount = Math.min(settings.enemyCount, allEnemies.length);
  for (let i = 0; i < enemyCount; i++) {
    const e = allEnemies[i];
    enemies.push({
      x: e.x, y: e.y, w: 28, h: 28,
      vx: i % 2 === 0 ? -1.3 : 1.3,
      minX: e.minX, maxX: e.maxX,
      alive: true, anim: 0
    });
  }

  // GOAL: KADO RAKSASA
  goal = { x: 3520, y: 240, w: 70, h: 100, reached: false };

  // Clouds
  for (let i = 0; i < 18; i++) {
    clouds.push({
      x: Math.random() * LEVEL_WIDTH,
      y: 40 + Math.random() * 100,
      size: 40 + Math.random() * 40
    });
  }

  gameState.photoFound = false;
}

// ============ AUDIO ============
let audioCtx = null;

function initAudio() {
  if (!audioCtx) {
    try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch(e) {}
  }
  if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
}

function playTone(freq, duration, type = 'square', vol = 0.1, delay = 0) {
  if (!audioCtx) return;
  const now = audioCtx.currentTime + delay;
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.type = type;
  osc.frequency.setValueAtTime(freq, now);
  gain.gain.setValueAtTime(0, now);
  gain.gain.linearRampToValueAtTime(vol, now + 0.01);
  gain.gain.exponentialRampToValueAtTime(0.001, now + duration);
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  osc.start(now);
  osc.stop(now + duration);
}

function sfx(name) {
  if (!audioCtx) return;
  switch(name) {
    case 'jump':
      playTone(400, 0.1, 'square', 0.08);
      playTone(700, 0.1, 'square', 0.08, 0.05);
      break;
    case 'coin':
      playTone(988, 0.08, 'square', 0.1);
      playTone(1318, 0.15, 'square', 0.1, 0.06);
      break;
    case 'stomp':
      playTone(200, 0.08, 'square', 0.1);
      playTone(150, 0.12, 'square', 0.1, 0.06);
      break;
    case 'hit':
      playTone(300, 0.15, 'sawtooth', 0.12);
      playTone(150, 0.25, 'sawtooth', 0.12, 0.1);
      break;
    case 'break':
      playTone(150, 0.1, 'sawtooth', 0.15);
      playTone(100, 0.15, 'sawtooth', 0.15, 0.08);
      playTone(80, 0.2, 'sawtooth', 0.12, 0.16);
      break;
    case 'reveal':
      [523, 659, 784, 1047].forEach((n, i) => {
        playTone(n, 0.25, 'triangle', 0.12, i * 0.1);
      });
      break;
    case 'win':
      [523, 659, 784, 1047, 784, 1047, 1319].forEach((n, i) => {
        playTone(n, 0.25, 'square', 0.12, i * 0.13);
      });
      break;
  }
}

// ============ INPUT ============
document.addEventListener('keydown', (e) => {
  initAudio();
  if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') keys.left = true;
  if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') keys.right = true;
  if (e.key === ' ' || e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') {
    if (!keys.jump) keys.jumpPressed = true;
    keys.jump = true;
    e.preventDefault();
  }
  if (e.key === 'r' || e.key === 'R') restartGame();
});

document.addEventListener('keyup', (e) => {
  if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') keys.left = false;
  if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') keys.right = false;
  if (e.key === ' ' || e.key === 'ArrowUp' || e.key === 'w' || e.key === 'W') keys.jump = false;
});

function mobileKey(dir, pressed) {
  initAudio();
  if (dir === 'jump' && pressed) keys.jumpPressed = true;
  keys[dir] = pressed;
}

// ============ GAME LOOP ============
let lastTime = 0;

function gameLoop(timestamp) {
  const dt = Math.min((timestamp - lastTime) / 16.67, 2);
  lastTime = timestamp;

  if (gameState.running) {
    update(dt);
    gameState.elapsedTime = (performance.now() - gameState.startTime) / 1000;
  }
  render();
  requestAnimationFrame(gameLoop);
}

// ============ UPDATE ============
function update(dt) {
  if (keys.left) { player.vx = -player.speed; player.facing = -1; }
  else if (keys.right) { player.vx = player.speed; player.facing = 1; }
  else { player.vx *= 0.75; if (Math.abs(player.vx) < 0.2) player.vx = 0; }

  if (keys.jumpPressed && player.onGround) {
    player.vy = player.jumpPower;
    player.onGround = false;
    sfx('jump');
  }
  keys.jumpPressed = false;

  player.vy += gameState.gravity * dt;
  if (player.vy > 18) player.vy = 18;

  player.x += player.vx * dt;
  player.y += player.vy * dt;

  if (player.x < 0) player.x = 0;
  if (player.x + player.w > LEVEL_WIDTH) player.x = LEVEL_WIDTH - player.w;

  // Platform collision
  player.onGround = false;
  let landedY = null;
  for (const p of platforms) {
    if (p.isSecret && secretWall.destroyed) continue;
    if (player.x + player.w > p.x && player.x < p.x + p.w) {
      const prevY = player.y - player.vy * dt;
      if (player.vy >= 0 && prevY + player.h <= p.y + 2 && player.y + player.h >= p.y && player.y + player.h <= p.y + p.h + 10) {
        if (landedY === null || p.y < landedY) landedY = p.y;
      }
    }
  }
  if (landedY !== null) {
    player.y = landedY - player.h;
    player.vy = 0;
    player.onGround = true;
  }

  // Secret wall collision
  if (!secretWall.destroyed && secretWall.shake <= 0) {
    const wallLeft = secretWall.x;
    const wallRight = secretWall.x + secretWall.w;
    const wallTop = secretWall.y;
    const wallBottom = secretWall.y + secretWall.h;
    
    if (player.x + player.w > wallLeft && player.x < wallRight &&
        player.y + player.h > wallTop && player.y < wallBottom) {
      if (player.vy < -3) {
        secretWall.shake = 20;
        secretWall.destroyed = true;
        sfx('break');
        burstConfettiAt(secretWall.x + secretWall.w/2, secretWall.y + secretWall.h/2, 30);
        player.vy = 3;
        setTimeout(() => sfx('reveal'), 500);
      }
    }
  }

  if (secretWall.shake > 0) secretWall.shake -= dt;

  // Photo reward
  if (!photoReward.collected && secretWall.destroyed) {
    if (player.x + player.w > photoReward.x && player.x < photoReward.x + photoReward.w &&
        player.y + player.h > photoReward.y && player.y < photoReward.y + photoReward.h) {
      photoReward.collected = true;
      gameState.photoFound = true;
      gameState.coins += 10;
      sfx('reveal');
      updateHUD();
      showPhotoFoundOverlay();
    }
  }

  if (player.y > H + 50) loseLife();

  // Coins
  for (const c of coins) {
    if (!c.collected) {
      if (player.x + player.w > c.x && player.x < c.x + c.w &&
          player.y + player.h > c.y && player.y < c.y + c.h) {
        c.collected = true;
        gameState.coins++;
        sfx('coin');
        updateHUD();
      }
    }
  }

  // Enemies
  for (const e of enemies) {
    if (!e.alive) continue;
    e.x += e.vx * dt;
    e.anim += 0.15 * dt;
    if (e.x <= e.minX) { e.x = e.minX; e.vx = Math.abs(e.vx); }
    if (e.x + e.w >= e.maxX) { e.x = e.maxX - e.w; e.vx = -Math.abs(e.vx); }

    if (player.x + player.w > e.x && player.x < e.x + e.w &&
        player.y + player.h > e.y && player.y < e.y + e.h) {
      if (player.vy > 0 && player.y + player.h - e.y < 20) {
        e.alive = false;
        player.vy = -9;
        sfx('stomp');
      } else if (player.invulnerable <= 0) {
        loseLife();
      }
    }
  }

  // Goal (GIFT BOX)
  if (!goal.reached &&
      player.x + player.w > goal.x && player.x < goal.x + goal.w &&
      player.y + player.h > goal.y && player.y < goal.y + goal.h) {
    goal.reached = true;
    winGame();
  }

  if (player.invulnerable > 0) player.invulnerable -= dt;
  player.animationFrame += 0.25 * dt;

  const targetCam = player.x - W / 3;
  gameState.cameraX += (targetCam - gameState.cameraX) * 0.1 * dt;
  if (gameState.cameraX < 0) gameState.cameraX = 0;
  if (gameState.cameraX > LEVEL_WIDTH - W) gameState.cameraX = LEVEL_WIDTH - W;
}

// ============ RENDER ============
function render() {
  const skyGrad = ctx.createLinearGradient(0, 0, 0, H);
  skyGrad.addColorStop(0, settings.skyColor);
  skyGrad.addColorStop(0.7, '#9bc4ff');
  skyGrad.addColorStop(1, '#c8e0ff');
  ctx.fillStyle = skyGrad;
  ctx.fillRect(0, 0, W, H);

  ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
  for (const c of clouds) {
    const cx = c.x - gameState.cameraX * 0.3;
    const wrappedX = ((cx % (W + 200)) + W + 200) % (W + 200) - 100;
    drawCloud(wrappedX, c.y, c.size);
  }

  ctx.fillStyle = 'rgba(100, 200, 100, 0.4)';
  for (let i = 0; i < 12; i++) {
    const hx = i * 400 - (gameState.cameraX * 0.5) % 400;
    drawHill(hx, H - 60, 150, 80);
    drawHill(hx + 200, H - 60, 100, 50);
  }

  ctx.save();
  ctx.translate(-gameState.cameraX, 0);

  for (const p of platforms) {
    if (p.isSecret && secretWall.destroyed) continue;
    drawPlatform(p);
  }

  if (!secretWall.destroyed) drawSecretWall();
  if (secretWall.destroyed && !photoReward.collected) drawPhotoReward();

  for (const c of coins) {
    if (!c.collected) drawCoin(c);
  }

  drawGoal(goal);

  for (const e of enemies) {
    if (e.alive) drawEnemy(e);
  }

  if (!(player.invulnerable > 0 && Math.floor(player.invulnerable / 4) % 2 === 0)) {
    drawPlayer();
  }

  ctx.restore();

  const vig = ctx.createRadialGradient(W/2, H/2, H/3, W/2, H/2, W/1.3);
  vig.addColorStop(0, 'rgba(0,0,0,0)');
  vig.addColorStop(1, 'rgba(0,0,0,0.25)');
  ctx.fillStyle = vig;
  ctx.fillRect(0, 0, W, H);
}

function drawCloud(x, y, size) {
  ctx.beginPath();
  ctx.arc(x, y, size * 0.5, 0, Math.PI * 2);
  ctx.arc(x + size * 0.5, y - size * 0.2, size * 0.6, 0, Math.PI * 2);
  ctx.arc(x + size, y, size * 0.5, 0, Math.PI * 2);
  ctx.arc(x + size * 0.5, y + size * 0.2, size * 0.5, 0, Math.PI * 2);
  ctx.fill();
}

function drawHill(x, baseY, w, h) {
  ctx.beginPath();
  ctx.ellipse(x + w/2, baseY, w/2, h, 0, Math.PI, 0);
  ctx.fill();
}

function drawPlatform(p) {
  if (p.type === 'ground') {
    ctx.fillStyle = '#8b5a2b';
    ctx.fillRect(p.x, p.y, p.w, p.h);
    ctx.fillStyle = '#6b3f1d';
    for (let i = 0; i < p.w; i += 20) {
      ctx.fillRect(p.x + i + 5, p.y + 15, 8, 8);
      ctx.fillRect(p.x + i + 12, p.y + 35, 6, 6);
    }
    ctx.fillStyle = '#3ea63e';
    ctx.fillRect(p.x, p.y, p.w, 12);
    ctx.fillStyle = '#5cc45c';
    ctx.fillRect(p.x, p.y, p.w, 5);
    ctx.fillStyle = '#3ea63e';
    for (let i = 0; i < p.w; i += 8) {
      ctx.fillRect(p.x + i, p.y - 4, 3, 5);
    }
  } else {
    ctx.fillStyle = '#c84c09';
    ctx.fillRect(p.x, p.y, p.w, p.h);
    ctx.fillStyle = '#e8722a';
    ctx.fillRect(p.x, p.y, p.w, 4);
    ctx.fillStyle = '#9a3806';
    for (let i = 0; i < p.w; i += 20) {
      ctx.fillRect(p.x + i + 18, p.y + 2, 2, p.h - 4);
    }
    ctx.fillRect(p.x, p.y + p.h/2, p.w, 2);
  }
}

function drawSecretWall() {
  const s = secretWall;
  let offsetX = 0, offsetY = 0;
  if (s.shake > 0) {
    offsetX = (Math.random() - 0.5) * s.shake * 0.5;
    offsetY = (Math.random() - 0.5) * s.shake * 0.5;
  }
  
  ctx.save();
  ctx.translate(offsetX, offsetY);
  ctx.shadowColor = '#ffeaa7';
  ctx.shadowBlur = 25 + Math.sin(performance.now() / 300) * 10;
  
  ctx.fillStyle = '#8b6914';
  ctx.fillRect(s.x, s.y, s.w, s.h);
  
  ctx.shadowBlur = 0;
  ctx.fillStyle = '#b8860b';
  ctx.fillRect(s.x + 2, s.y + 2, s.w - 4, s.h - 4);
  
  ctx.fillStyle = '#8b6914';
  for (let row = 0; row < 6; row++) {
    for (let col = 0; col < 2; col++) {
      const bx = s.x + 3 + col * 18 + (row % 2 === 1 ? 9 : 0);
      const by = s.y + 3 + row * 18;
      if (bx + 15 < s.x + s.w) ctx.fillRect(bx, by, 15, 15);
    }
  }
  
  ctx.fillStyle = '#ffeaa7';
  ctx.font = 'bold 24px sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText('?', s.x + s.w/2, s.y + s.h/2 - 5);
  
  ctx.font = 'bold 10px sans-serif';
  ctx.fillStyle = '#ff6b9d';
  ctx.fillText('↑', s.x + s.w/2, s.y + s.h/2 + 20);
  
  ctx.restore();
}

function drawPhotoReward() {
  const p = photoReward;
  const t = performance.now() / 400;
  const float = Math.sin(t) * 4;
  
  ctx.save();
  ctx.shadowColor = '#74b9ff';
  ctx.shadowBlur = 25 + Math.sin(t * 2) * 10;
  
  ctx.fillStyle = '#ffeaa7';
  ctx.fillRect(p.x - 5, p.y + float - 5, p.w + 10, p.h + 10);
  
  ctx.shadowBlur = 0;
  ctx.fillStyle = '#74b9ff';
  ctx.fillRect(p.x, p.y + float, p.w, p.h);
  ctx.fillStyle = 'white';
  ctx.font = 'bold 20px sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText('📸', p.x + p.w/2, p.y + float + p.h/2);
  
  for (let i = 0; i < 4; i++) {
    const angle = t * 2 + i * Math.PI / 2;
    const sx = p.x + p.w/2 + Math.cos(angle) * 25;
    const sy = p.y + float + p.h/2 + Math.sin(angle) * 25;
    ctx.fillStyle = `rgba(255, 234, 167, ${0.6 + Math.sin(t*3 + i)*0.3})`;
    ctx.beginPath();
    ctx.arc(sx, sy, 3, 0, Math.PI * 2);
    ctx.fill();
  }
  
  ctx.restore();
}

function drawCoin(c) {
  const t = performance.now() / 200 + c.anim;
  const scaleX = Math.abs(Math.cos(t));
  const cx = c.x + c.w / 2;
  const cy = c.y + c.h / 2;
  const r = c.w / 2;

  ctx.save();
  ctx.translate(cx, cy);
  ctx.scale(scaleX, 1);
  ctx.shadowColor = '#ffd93d';
  ctx.shadowBlur = 15;
  ctx.fillStyle = '#ffd93d';
  ctx.beginPath();
  ctx.arc(0, 0, r, 0, Math.PI * 2);
  ctx.fill();
  ctx.shadowBlur = 0;
  ctx.fillStyle = '#ffeaa7';
  ctx.beginPath();
  ctx.arc(-r*0.15, -r*0.15, r*0.6, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = '#b8860b';
  ctx.font = 'bold 14px sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText('★', 0, 1);
  ctx.restore();
}

function drawEnemy(e) {
  const bounce = Math.sin(e.anim) * 3;
  
  ctx.fillStyle = 'rgba(0,0,0,0.3)';
  ctx.beginPath();
  ctx.ellipse(e.x + e.w/2, e.y + e.h + 2, e.w/2, 4, 0, 0, Math.PI * 2);
  ctx.fill();

  const grad = ctx.createLinearGradient(e.x, e.y, e.x, e.y + e.h);
  grad.addColorStop(0, '#a0522d');
  grad.addColorStop(1, '#6b3410');
  ctx.fillStyle = grad;
  ctx.beginPath();
  ctx.moveTo(e.x, e.y + e.h);
  ctx.quadraticCurveTo(e.x + e.w/2, e.y - 5 + bounce, e.x + e.w, e.y + e.h);
  ctx.closePath();
  ctx.fill();

  ctx.fillStyle = 'white';
  ctx.beginPath();
  ctx.arc(e.x + e.w*0.3, e.y + e.h*0.5, 5, 0, Math.PI * 2);
  ctx.arc(e.x + e.w*0.7, e.y + e.h*0.5, 5, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = 'black';
  const eyeDir = e.vx > 0 ? 1.5 : -1.5;
  ctx.beginPath();
  ctx.arc(e.x + e.w*0.3 + eyeDir, e.y + e.h*0.5, 2.5, 0, Math.PI * 2);
  ctx.arc(e.x + e.w*0.7 + eyeDir, e.y + e.h*0.5, 2.5, 0, Math.PI * 2);
  ctx.fill();

  ctx.strokeStyle = 'black';
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(e.x + e.w*0.2, e.y + e.h*0.35);
  ctx.lineTo(e.x + e.w*0.4, e.y + e.h*0.42);
  ctx.moveTo(e.x + e.w*0.8, e.y + e.h*0.35);
  ctx.lineTo(e.x + e.w*0.6, e.y + e.h*0.42);
  ctx.stroke();

  ctx.fillStyle = '#3d1f08';
  ctx.beginPath();
  ctx.ellipse(e.x + e.w*0.25, e.y + e.h, 6, 4, 0, 0, Math.PI * 2);
  ctx.ellipse(e.x + e.w*0.75, e.y + e.h, 6, 4, 0, 0, Math.PI * 2);
  ctx.fill();
}

function drawPlayer() {
  const x = player.x;
  const y = player.y;
  const w = player.w;
  const h = player.h;
  const bounce = player.onGround ? Math.sin(player.animationFrame * 2) * 1.5 : 0;

  if (player.onGround) {
    ctx.fillStyle = 'rgba(0,0,0,0.25)';
    ctx.beginPath();
    ctx.ellipse(x + w/2, y + h + 3, w/2, 4, 0, 0, Math.PI * 2);
    ctx.fill();
  }

  ctx.save();
  ctx.translate(x + w/2, y + h/2 + bounce);
  if (player.facing === -1) ctx.scale(-1, 1);

  ctx.fillStyle = '#ffdbac';
  ctx.beginPath();
  ctx.arc(0, -8, 10, 0, Math.PI * 2);
  ctx.fill();

  ctx.fillStyle = settings.colorPrimary;
  ctx.beginPath();
  ctx.moveTo(-12, -14);
  ctx.lineTo(12, -14);
  ctx.lineTo(0, -32);
  ctx.closePath();
  ctx.fill();
  ctx.fillStyle = '#ffeaa7';
  ctx.beginPath();
  ctx.arc(0, -32, 4, 0, Math.PI * 2);
  ctx.fill();
  ctx.strokeStyle = '#ffeaa7';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.moveTo(-6, -22); ctx.lineTo(6, -22);
  ctx.moveTo(-9, -18); ctx.lineTo(9, -18);
  ctx.stroke();
  ctx.fillStyle = '#c44569';
  ctx.fillRect(-12, -16, 24, 3);

  ctx.fillStyle = 'black';
  ctx.beginPath();
  ctx.arc(-3, -8, 1.8, 0, Math.PI * 2);
  ctx.arc(3, -8, 1.8, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = 'white';
  ctx.beginPath();
  ctx.arc(-2.5, -8.5, 0.7, 0, Math.PI * 2);
  ctx.arc(3.5, -8.5, 0.7, 0, Math.PI * 2);
  ctx.fill();

  ctx.strokeStyle = '#8b4513';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.arc(0, -5, 4, 0.2, Math.PI - 0.2);
  ctx.stroke();

  ctx.fillStyle = 'rgba(255, 150, 150, 0.6)';
  ctx.beginPath();
  ctx.arc(-7, -5, 2.5, 0, Math.PI * 2);
  ctx.arc(7, -5, 2.5, 0, Math.PI * 2);
  ctx.fill();

  ctx.fillStyle = settings.colorPrimary;
  ctx.fillRect(-9, 2, 18, 12);
  ctx.fillStyle = '#c44569';
  ctx.fillRect(-6, 2, 3, 12);
  ctx.fillRect(3, 2, 3, 12);
  ctx.fillStyle = '#ffeaa7';
  ctx.beginPath();
  ctx.arc(-5, 6, 1.5, 0, Math.PI * 2);
  ctx.arc(5, 6, 1.5, 0, Math.PI * 2);
  ctx.fill();

  const armSwing = player.onGround ? Math.sin(player.animationFrame * 2) * 3 : -3;
  ctx.fillStyle = '#ffdbac';
  ctx.beginPath();
  ctx.arc(-11, 5 + armSwing, 3.5, 0, Math.PI * 2);
  ctx.fill();
  ctx.beginPath();
  ctx.arc(11, 5 - armSwing, 3.5, 0, Math.PI * 2);
  ctx.fill();

  const legSwing = player.onGround && Math.abs(player.vx) > 0.5 ? Math.sin(player.animationFrame * 3) * 3 : 0;
  ctx.fillStyle = '#4a4a4a';
  ctx.fillRect(-6, 14 + legSwing, 5, 8);
  ctx.fillRect(1, 14 - legSwing, 5, 8);
  ctx.fillStyle = '#2a2a2a';
  ctx.beginPath();
  ctx.ellipse(-4, 22 + legSwing, 4, 3, 0, 0, Math.PI * 2);
  ctx.ellipse(3, 22 - legSwing, 4, 3, 0, 0, Math.PI * 2);
  ctx.fill();

  ctx.restore();
}

// ============ DRAW GOAL: KADO RAKSASA ============
function drawGoal(g) {
  if (!g) return;
  const t = performance.now() / 500;
  const float = Math.sin(t) * 6;
  const glow = 0.5 + Math.sin(t * 2) * 0.3;

  // Outer sparkles
  for (let i = 0; i < 8; i++) {
    const angle = t * 1.5 + i * Math.PI / 4;
    const sx = g.x + g.w/2 + Math.cos(angle) * 65;
    const sy = g.y + g.h/2 + float + Math.sin(angle) * 65;
    ctx.fillStyle = `rgba(255, 234, 167, ${0.5 + Math.sin(t*3 + i)*0.4})`;
    ctx.beginPath();
    ctx.arc(sx, sy, 3 + Math.sin(t*4 + i) * 1.5, 0, Math.PI * 2);
    ctx.fill();
  }

  // Glow radial
  const glowGrad = ctx.createRadialGradient(g.x + g.w/2, g.y + g.h/2 + float, 5, g.x + g.w/2, g.y + g.h/2 + float, 85);
  glowGrad.addColorStop(0, `rgba(255, 234, 167, ${glow * 0.6})`);
  glowGrad.addColorStop(0.5, `rgba(255, 107, 157, ${glow * 0.3})`);
  glowGrad.addColorStop(1, 'rgba(255, 234, 167, 0)');
  ctx.fillStyle = glowGrad;
  ctx.fillRect(g.x - 40, g.y - 40 + float, g.w + 80, g.h + 80);

  const cx = g.x + g.w/2;
  const cy = g.y + g.h/2 + float;

  // Shadow
  ctx.fillStyle = 'rgba(0,0,0,0.3)';
  ctx.beginPath();
  ctx.ellipse(cx, g.y + g.h + 5, g.w/2, 6, 0, 0, Math.PI * 2);
  ctx.fill();

  // === KADO RAKSASA ===
  // Box body
  const boxW = 64;
  const boxH = 62;
  const boxX = cx - boxW/2;
  const boxY = cy + 5;

  // Body gradient
  const bodyGrad = ctx.createLinearGradient(boxX, boxY, boxX + boxW, boxY + boxH);
  bodyGrad.addColorStop(0, '#ff6b9d');
  bodyGrad.addColorStop(1, '#c44569');
  ctx.fillStyle = bodyGrad;
  ctx.fillRect(boxX, boxY, boxW, boxH);

  // Box bottom shadow
  ctx.fillStyle = 'rgba(0,0,0,0.2)';
  ctx.fillRect(boxX, boxY + boxH - 6, boxW, 6);

  // Box highlight
  ctx.fillStyle = 'rgba(255,255,255,0.15)';
  ctx.fillRect(boxX + 4, boxY + 4, 8, boxH - 12);

  // Vertical ribbon
  ctx.fillStyle = '#ffeaa7';
  ctx.fillRect(cx - 7, boxY, 14, boxH);

  // Ribbon shine
  ctx.fillStyle = '#ffd93d';
  ctx.fillRect(cx - 7, boxY, 4, boxH);

  // === LID ===
  const lidW = boxW + 12;
  const lidH = 16;
  const lidX = cx - lidW/2;
  const lidY = boxY - lidH + 2;

  // Lid gradient
  const lidGrad = ctx.createLinearGradient(lidX, lidY, lidX + lidW, lidY + lidH);
  lidGrad.addColorStop(0, '#ff9ecd');
  lidGrad.addColorStop(1, '#ff6b9d');
  ctx.fillStyle = lidGrad;
  ctx.fillRect(lidX, lidY, lidW, lidH);

  // Lid top shine
  ctx.fillStyle = 'rgba(255,255,255,0.3)';
  ctx.fillRect(lidX, lidY, lidW, 3);

  // Lid ribbon vertical
  ctx.fillStyle = '#ffeaa7';
  ctx.fillRect(cx - 7, lidY, 14, lidH);

  // === PITA / BOW ON TOP ===
  const bowY = lidY - 8;
  
  // Left loop
  ctx.fillStyle = '#ffd93d';
  ctx.beginPath();
  ctx.ellipse(cx - 14, bowY, 13, 10, -0.4, 0, Math.PI * 2);
  ctx.fill();
  
  // Right loop
  ctx.beginPath();
  ctx.ellipse(cx + 14, bowY, 13, 10, 0.4, 0, Math.PI * 2);
  ctx.fill();
  
  // Loop inner highlight
  ctx.fillStyle = '#ffeaa7';
  ctx.beginPath();
  ctx.ellipse(cx - 14, bowY - 2, 6, 4, -0.4, 0, Math.PI * 2);
  ctx.fill();
  ctx.beginPath();
  ctx.ellipse(cx + 14, bowY - 2, 6, 4, 0.4, 0, Math.PI * 2);
  ctx.fill();

  // Center knot
  ctx.fillStyle = '#ffd93d';
  ctx.beginPath();
  ctx.arc(cx, bowY, 6, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = '#ffeaa7';
  ctx.beginPath();
  ctx.arc(cx - 1, bowY - 1, 2.5, 0, Math.PI * 2);
  ctx.fill();

  // Bottom ribbon tails
  ctx.fillStyle = '#ffd93d';
  ctx.beginPath();
  ctx.moveTo(cx - 8, lidY + 4);
  ctx.lineTo(cx - 16, lidY + 18);
  ctx.lineTo(cx - 10, lidY + 18);
  ctx.lineTo(cx - 4, lidY + 6);
  ctx.closePath();
  ctx.fill();

  ctx.beginPath();
  ctx.moveTo(cx + 8, lidY + 4);
  ctx.lineTo(cx + 16, lidY + 18);
  ctx.lineTo(cx + 10, lidY + 18);
  ctx.lineTo(cx + 4, lidY + 6);
  ctx.closePath();
  ctx.fill();

  // ❤️ Emoji kecil di tengah kotak
  ctx.font = 'bold 14px sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText('💝', cx, boxY + boxH/2);

  // HBD text di bawah
  ctx.fillStyle = '#ffeaa7';
  ctx.font = 'bold 11px sans-serif';
  ctx.fillText('HBD!', cx, g.y + g.h + 22);
}

// ============ GAME ACTIONS ============
function startGame() {
  initAudio();
  document.getElementById('startOverlay').classList.remove('show');
  resetPlayerAndLevel();
  gameState.running = true;
  gameState.startTime = performance.now();
  sfx('reveal');
}

function restartGame() {
  document.querySelectorAll('.overlay').forEach(o => o.classList.remove('show'));
  document.getElementById('startOverlay').classList.add('show');
  gameState.running = false;
  gameState.lives = 3;
  gameState.coins = 0;
  updateHUD();
  resetPlayerAndLevel();
}

function resetPlayerAndLevel() {
  player.x = 50;
  player.y = 250;
  player.vx = 0;
  player.vy = 0;
  player.onGround = false;
  player.invulnerable = 0;
  player.facing = 1;
  gameState.cameraX = 0;
  gameState.startTime = performance.now();
  gameState.photoFound = false;
  generateLevel();
}

function loseLife() {
  gameState.lives--;
  updateHUD();
  sfx('hit');
  if (gameState.lives <= 0) {
    gameState.running = false;
    document.getElementById('gameOverOverlay').classList.add('show');
    return;
  }
  player.x = Math.max(0, player.x - 200);
  player.y = 100;
  player.vx = 0;
  player.vy = 0;
  player.invulnerable = 90;
}

function showPhotoFoundOverlay() {
  const frame = document.getElementById('photoFoundFrame');
  if (settings.photo) {
    frame.innerHTML = `<img src="${settings.photo}" alt="Foto">`;
  } else {
    frame.innerHTML = `<div style="width:130px;height:130px;border-radius:50%;background:#74b9ff;display:flex;align-items:center;justify-content:center;font-size:3rem;">📸</div>`;
  }
  document.getElementById('photoFoundOverlay').classList.add('show');
  gameState.running = false;
  showConfettiBurst();
}

function closePhotoFound() {
  document.getElementById('photoFoundOverlay').classList.remove('show');
  gameState.running = true;
  gameState.startTime = performance.now() - gameState.elapsedTime * 1000;
}

function winGame() {
  gameState.running = false;
  sfx('win');
  
  const time = Math.round(gameState.elapsedTime);
  document.getElementById('finalCoins').textContent = gameState.coins;
  document.getElementById('finalTime').textContent = time + 's';
  document.getElementById('finalLives').textContent = gameState.lives;
  document.getElementById('bdayName').textContent = settings.name;
  document.getElementById('bdayMessage').textContent = settings.message;
  
  const frame = document.getElementById('bdayPhotoFrame');
  if (settings.photo) {
    frame.innerHTML = `<img src="${settings.photo}" alt="Foto">`;
  } else {
    frame.innerHTML = '';
  }
  
  setTimeout(() => {
    document.getElementById('birthdayOverlay').classList.add('show');
    showConfettiBurst();
  }, 500);
}

function updateHUD() {
  document.getElementById('livesDisplay').textContent = gameState.lives;
  document.getElementById('coinsDisplay').textContent = gameState.coins;
  document.getElementById('photoDisplay').textContent = gameState.photoFound ? 1 : 0;
}

// ============ CONFETTI ============
const confettiColors = ['#ff6b9d', '#ffeaa7', '#74b9ff', '#a29bfe', '#fd79a8', '#00b894', '#e17055', '#ffd93d'];

function createConfettiPiece(x, y) {
  const c = document.createElement('div');
  c.className = 'confetti-piece';
  c.style.left = x + 'vw';
  c.style.background = confettiColors[Math.floor(Math.random() * confettiColors.length)];
  c.style.width = c.style.height = (6 + Math.random() * 10) + 'px';
  c.style.animationDuration = (2.5 + Math.random() * 2.5) + 's';
  if (Math.random() > 0.5) c.style.borderRadius = '50%';
  document.body.appendChild(c);
  setTimeout(() => c.remove(), 5500);
}

function burstConfettiAt(canvasX, canvasY, n) {
  const rect = canvas.getBoundingClientRect();
  const scaleX = rect.width / W;
  const scaleY = rect.height / H;
  const screenX = rect.left + (canvasX - gameState.cameraX) * scaleX;
  const screenY = rect.top + canvasY * scaleY;
  const xVw = (screenX / window.innerWidth) * 100;
  
  for (let i = 0; i < n; i++) {
    setTimeout(() => {
      const c = document.createElement('div');
      c.className = 'confetti-piece';
      c.style.left = (xVw + (Math.random() - 0.5) * 10) + 'vw';
      c.style.top = (screenY / window.innerHeight * 100) + 'vh';
      c.style.background = confettiColors[Math.floor(Math.random() * confettiColors.length)];
      c.style.width = c.style.height = (6 + Math.random() * 10) + 'px';
      c.style.animationDuration = (2 + Math.random() * 2) + 's';
      if (Math.random() > 0.5) c.style.borderRadius = '50%';
      document.body.appendChild(c);
      setTimeout(() => c.remove(), 4500);
    }, i * 15);
  }
}

function showConfettiBurst() {
  for (let i = 0; i < 120; i++) {
    setTimeout(() => createConfettiPiece(Math.random() * 100, 0), i * 15);
  }
  if (audioCtx) {
    [523, 659, 784, 1047].forEach((n, i) => playTone(n, 0.3, 'triangle', 0.12, i * 0.15));
  }
}

// ============ SETTINGS ============
function loadSettings() {
  try {
    const saved = localStorage.getItem('birthday_game_settings');
    if (saved) {
      const parsed = JSON.parse(saved);
      settings = { ...DEFAULT, ...parsed };
    }
  } catch(e) {}
}

function persistSettings() {
  try {
    localStorage.setItem('birthday_game_settings', JSON.stringify(settings));
  } catch(e) {
    alert('⚠️ Penyimpanan penuh! Coba pakai foto yang lebih kecil.');
  }
}

function toggleEdit() {
  document.getElementById('editPanel').classList.toggle('open');
}

function saveSettings() {
  settings.name = document.getElementById('inputName').value.trim() || DEFAULT.name;
  settings.message = document.getElementById('inputMessage').value.trim() || DEFAULT.message;
  settings.coverTitle = document.getElementById('inputCoverTitle').value.trim() || DEFAULT.coverTitle;
  settings.coverDesc = document.getElementById('inputCoverDesc').value.trim() || DEFAULT.coverDesc;
  settings.enemyCount = Math.max(1, Math.min(10, parseInt(document.getElementById('inputEnemyCount').value) || 5));
  settings.coinCount = Math.max(10, Math.min(60, parseInt(document.getElementById('inputCoinCount').value) || 34));
  settings.colorPrimary = document.getElementById('inputColorPrimary').value;
  settings.skyColor = document.getElementById('inputSkyColor').value;
  
  const photoFile = document.getElementById('inputPhoto').files[0];
  if (photoFile) {
    const reader = new FileReader();
    reader.onload = (e) => {
      settings.photo = e.target.result;
      persistSettings();
      applySettings();
      toggleEdit();
    };
    reader.readAsDataURL(photoFile);
    return;
  }
  
  applySettings();
  persistSettings();
  toggleEdit();
}

function resetAll() {
  if (!confirm('Yakin reset semua ke default?')) return;
  settings = JSON.parse(JSON.stringify(DEFAULT));
  localStorage.removeItem('birthday_game_settings');
  applySettings();
  generateLevel();
}

function applySettings() {
  document.getElementById('inputName').value = settings.name;
  document.getElementById('inputMessage').value = settings.message;
  document.getElementById('inputCoverTitle').value = settings.coverTitle;
  document.getElementById('inputCoverDesc').value = settings.coverDesc;
  document.getElementById('inputEnemyCount').value = settings.enemyCount;
  document.getElementById('inputCoinCount').value = settings.coinCount;
  document.getElementById('inputColorPrimary').value = settings.colorPrimary;
  document.getElementById('inputSkyColor').value = settings.skyColor;
  
  document.documentElement.style.setProperty('--primary', settings.colorPrimary);
  
  const coverTitle = document.querySelector('#startOverlay h1');
  const coverDesc = document.querySelector('#startOverlay p');
  if (coverTitle) coverTitle.textContent = settings.coverTitle;
  if (coverDesc) coverDesc.innerHTML = settings.coverDesc.replace(/\n/g, '<br>') + '<br><em>Seseorang meninggalkan ini khusus untukmu 💫</em>';
  
  const preview = document.getElementById('photoPreview');
  if (settings.photo) {
    preview.src = settings.photo;
    preview.classList.add('show');
  } else {
    preview.classList.remove('show');
  }
}

// ============ INIT ============
loadSettings();
generateLevel();
applySettings();
updateHUD();
requestAnimationFrame(gameLoop);
</script>
