<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>✨ Petualangan Misterius ✨</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Segoe UI', Roboto, sans-serif;
    background: #0a0a1a;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    color: white;
    overflow: hidden;
  }

  .game-wrapper {
    position: relative;
    max-width: 900px;
    width: 100%;
    background: linear-gradient(135deg, #1a0b2e, #16213e);
    border-radius: 1.5rem;
    padding: 1rem;
    box-shadow: 0 30px 80px rgba(0,0,0,0.8), 0 0 60px rgba(255,107,157,0.2);
    border: 2px solid rgba(255,234,167,0.2);
  }

  .game-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 1rem 0.8rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .game-title {
    font-size: 1.2rem;
    font-weight: 800;
    background: linear-gradient(135deg, #ffeaa7, #ff6b9d);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: 1px;
  }

  .hud {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffeaa7;
  }

  .hud-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(0,0,0,0.4);
    padding: 0.4rem 0.9rem;
    border-radius: 2rem;
    border: 1px solid rgba(255,234,167,0.3);
  }

  .hud-icon { font-size: 1.1rem; }

  canvas {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1rem;
    background: #5c94fc;
    box-shadow: inset 0 0 30px rgba(0,0,0,0.3);
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    touch-action: none;
  }

  .controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 1rem 0.3rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .controls-hint {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.6);
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .key {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 0.3rem;
    font-weight: 700;
    font-size: 0.75rem;
    margin: 0 0.15rem;
  }

  .btn {
    background: linear-gradient(135deg, #ff6b9d, #c44569);
    border: none;
    color: white;
    padding: 0.6rem 1.2rem;
    border-radius: 2rem;
    font-weight: 700;
    cursor: pointer;
    font-size: 0.85rem;
    box-shadow: 0 4px 0 #8b2d4a;
    transition: all 0.1s;
    margin-left: 0.4rem;
  }

  .btn:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 #8b2d4a;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(10, 5, 20, 0.95);
    backdrop-filter: blur(15px);
    border-radius: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    z-index: 10;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s;
  }

  .overlay.show {
    opacity: 1;
    visibility: visible;
  }

  .overlay h1 {
    font-size: clamp(1.5rem, 5vw, 2.5rem);
    font-weight: 900;
    background: linear-gradient(135deg, #a29bfe, #74b9ff, #ffeaa7);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    background-size: 200% 200%;
    animation: shimmer 3s ease-in-out infinite;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  @keyframes shimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .overlay p {
    font-size: 1rem;
    color: rgba(255,255,255,0.85);
    max-width: 500px;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .overlay-btn {
    background: linear-gradient(135deg, #ffeaa7, #ffd93d);
    border: none;
    color: #4a2b00;
    padding: 1rem 2.5rem;
    border-radius: 3rem;
    font-size: 1.1rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 8px 0 #b8860b, 0 10px 30px rgba(255,234,167,0.4);
    transition: all 0.15s;
    letter-spacing: 1px;
    margin-top: 0.5rem;
  }

  .overlay-btn:hover { transform: translateY(-3px); }
  .overlay-btn:active {
    transform: translateY(5px);
    box-shadow: 0 3px 0 #b8860b;
  }

  .mystery-box-cover {
    width: 180px;
    height: 180px;
    background: linear-gradient(135deg, #1a0b2e, #2d1b4e);
    border-radius: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 6rem;
    cursor: pointer;
    position: relative;
    margin-bottom: 2rem;
    box-shadow: 
      0 0 60px rgba(255,234,167,0.3),
      0 25px 50px rgba(0,0,0,0.6),
      inset 0 2px 20px rgba(255,234,167,0.2);
    border: 2px solid rgba(255,234,167,0.3);
    animation: boxGlow 3s ease-in-out infinite, boxFloat 4s ease-in-out infinite;
  }

  @keyframes boxGlow {
    0%, 100% { box-shadow: 0 0 60px rgba(255,234,167,0.3), 0 25px 50px rgba(0,0,0,0.6), inset 0 2px 20px rgba(255,234,167,0.2); }
    50% { box-shadow: 0 0 100px rgba(255,234,167,0.6), 0 25px 50px rgba(0,0,0,0.6), inset 0 2px 20px rgba(255,234,167,0.4); }
  }

  @keyframes boxFloat {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-15px) rotate(2deg); }
  }

  .mystery-box-cover::before {
    content: '❓';
    position: absolute;
    font-size: 5rem;
    animation: questionPulse 2s ease-in-out infinite;
  }

  @keyframes questionPulse {
    0%, 100% { opacity: 0.9; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.1); }
  }

  .mystery-box-cover .lock {
    position: absolute;
    bottom: -15px;
    right: -15px;
    font-size: 2rem;
    animation: lockShake 3s ease-in-out infinite;
  }

  @keyframes lockShake {
    0%, 90%, 100% { transform: rotate(0); }
    93% { transform: rotate(-10deg); }
    96% { transform: rotate(10deg); }
  }

  .birthday-content {
    max-width: 600px;
    width: 100%;
    padding: 2rem;
    background: rgba(255,255,255,0.05);
    border-radius: 2rem;
    border: 2px solid #ffeaa7;
    box-shadow: 0 0 60px rgba(255,234,167,0.4);
    animation: glowCard 3s ease-in-out infinite;
    max-height: 90vh;
    overflow-y: auto;
  }

  @keyframes glowCard {
    0%, 100% { box-shadow: 0 0 40px rgba(255,234,167,0.3); }
    50% { box-shadow: 0 0 80px rgba(255,234,167,0.6); }
  }

  .birthday-gift {
    font-size: 5rem;
    animation: bounce 1.5s ease-in-out infinite;
    filter: drop-shadow(0 10px 20px rgba(255,107,157,0.5));
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0) rotate(-5deg); }
    50% { transform: translateY(-15px) rotate(5deg); }
  }

  .birthday-greeting {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: #ffeaa7;
    margin: 1rem 0 0.5rem;
  }

  .birthday-name {
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 900;
    background: linear-gradient(135deg, #ffeaa7 0%, #ff6b9d 50%, #74b9ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    background-size: 200% 200%;
    animation: shimmer 3s ease-in-out infinite;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .birthday-photo-frame {
    display: inline-block;
    padding: 6px;
    background: linear-gradient(135deg, #ffeaa7, #ff6b9d);
    border-radius: 50%;
    margin: 0.5rem 0 1rem;
    box-shadow: 0 15px 35px rgba(0,0,0,0.5);
  }

  .birthday-photo-frame img {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    border: 4px solid rgba(0,0,0,0.2);
  }

  .birthday-photo-frame:empty { display: none; }

  .birthday-message {
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.95);
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: rgba(0,0,0,0.3);
    border-radius: 1rem;
    border-left: 4px solid #ff6b9d;
    text-align: left;
    white-space: pre-wrap;
  }

  .birthday-stats {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .stat-item { text-align: center; }

  .stat-value {
    font-size: 1.8rem;
    font-weight: 900;
    color: #ffeaa7;
  }

  .stat-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: rgba(255,255,255,0.6);
    margin-top: 0.2rem;
  }

  .confetti-piece {
    position: fixed;
    width: 10px;
    height: 10px;
    top: -20px;
    pointer-events: none;
    z-index: 999;
    animation: confettiFall linear;
  }

  @keyframes confettiFall {
    0% { transform: translateY(0) rotate(0deg); opacity: 1; }
    100% { transform: translateY(110vh) rotate(720deg); opacity: 0.3; }
  }

  .mobile-controls {
    display: none;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    pointer-events: none;
  }

  .mobile-btn {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: rgba(255,234,167,0.9);
    border: 3px solid #ffeaa7;
    font-size: 1.8rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 20px rgba(0,0,0,0.5);
    pointer-events: auto;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    color: #4a2b00;
    font-weight: 900;
  }

  .mobile-btn:active {
    transform: scale(0.9);
    background: #ffd93d;
  }

  .mobile-controls-left { display: flex; gap: 1rem; pointer-events: auto; }
  .mobile-controls-right { pointer-events: auto; }

  @media (max-width: 700px) {
    .mobile-controls { display: flex; }
    .game-header { padding: 0.5rem; }
    .hud { font-size: 0.8rem; gap: 0.8rem; }
    .hud-item { padding: 0.3rem 0.6rem; }
    .controls-hint { display: none; }
    .game-wrapper { padding: 0.5rem; }
  }

  .edit-toggle {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(0,0,0,0.7);
    border: 2px solid #ffeaa7;
    color: #ffeaa7;
    font-size: 1.4rem;
    cursor: pointer;
    z-index: 700;
    backdrop-filter: blur(10px);
    transition: transform 0.3s;
  }

  .edit-toggle:hover { transform: rotate(45deg); }

  .edit-panel {
    position: fixed;
    top: 0;
    right: -440px;
    width: 420px;
    max-width: 92vw;
    height: 100vh;
    background: rgba(20, 15, 35, 0.98);
    backdrop-filter: blur(20px);
    z-index: 800;
    padding: 1.5rem;
    overflow-y: auto;
    transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: -10px 0 30px rgba(0,0,0,0.5);
    border-left: 1px solid rgba(255,255,255,0.1);
  }

  .edit-panel.open { right: 0; }

  .edit-panel h3 {
    color: #ffeaa7;
    margin-bottom: 1rem;
    font-size: 1.2rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid rgba(255,255,255,0.15);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .close-edit {
    background: none;
    border: none;
    color: #ffeaa7;
    font-size: 1.5rem;
    cursor: pointer;
    padding: 0 0.5rem;
  }

  .form-section {
    margin-bottom: 1.3rem;
    padding-bottom: 1rem;
    border-bottom: 1px dashed rgba(255,255,255,0.1);
  }

  .form-section-title {
    font-size: 0.8rem;
    font-weight: 800;
    color: #ff6b9d;
    margin-bottom: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .form-group {
    margin-bottom: 0.9rem;
  }

  .form-group label {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #ffeaa7;
    margin-bottom: 0.35rem;
    font-weight: 600;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 0.6rem 0.9rem;
    border-radius: 0.7rem;
    border: 1px solid rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.08);
    color: white;
    font-size: 0.85rem;
    font-family: inherit;
    transition: border 0.2s;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #ff6b9d;
    background: rgba(255,255,255,0.12);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 70px;
  }

  .form-group input[type="color"] {
    height: 42px;
    padding: 0.3rem;
    cursor: pointer;
  }

  .form-group input[type="file"] {
    padding: 0.5rem;
    font-size: 0.78rem;
  }

  .photo-preview {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #ffeaa7;
    margin-top: 0.5rem;
    display: none;
  }

  .photo-preview.show { display: block; }

  .edit-actions {
    display: flex;
    gap: 0.6rem;
    margin-top: 1rem;
    position: sticky;
    bottom: 0;
    background: rgba(20, 15, 35, 0.98);
    padding: 1rem 0 0.5rem;
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .edit-actions button {
    flex: 1;
    padding: 0.75rem;
    border: none;
    border-radius: 0.7rem;
    font-weight: 700;
    cursor: pointer;
    font-size: 0.85rem;
  }

  .btn-save {
    background: linear-gradient(135deg, #ff6b9d, #c44569);
    color: white;
  }

  .btn-cancel {
    background: rgba(255,255,255,0.1);
    color: white;
    border: 1px solid rgba(255,255,255,0.2) !important;
  }

  .btn-reset {
    background: rgba(255,107,107,0.2);
    color: #ff6b6b;
    border: 1px solid rgba(255,107,107,0.4) !important;
    width: 100%;
    padding: 0.65rem;
    border-radius: 0.7rem;
    font-weight: 600;
    cursor: pointer;
    font-size: 0.8rem;
    margin-top: 0.5rem;
  }

  .help-text {
    font-size: 0.7rem;
    color: #888;
    margin-top: 0.3rem;
    line-height: 1.4;
  }
</style>
</head>
<body>

<div class="game-wrapper">
  <div class="game-header">
    <div class="game-title">✨ Petualangan Misterius</div>
    <div class="hud">
      <div class="hud-item"><span class="hud-icon">❤️</span><span id="livesDisplay">3</span></div>
      <div class="hud-item"><span class="hud-icon">🪙</span><span id="coinsDisplay">0</span></div>
      <div class="hud-item"><span class="hud-icon">📸</span><span id="photoDisplay">0</span></div>
    </div>
  </div>

  <canvas id="gameCanvas" width="800" height="400"></canvas>

  <div class="controls">
    <div class="controls-hint">
      <span><span class="key">←</span> <span class="key">→</span> Gerak</span>
      <span><span class="key">SPACE</span> / <span class="key">↑</span> Lompat</span>
      <span><span class="key">R</span> Restart</span>
    </div>
    <button class="btn" onclick="restartGame()">🔄 Ulangi</button>
  </div>

  <!-- START / MYSTERY COVER -->
  <div class="overlay show" id="startOverlay">
    <div class="mystery-box-cover" onclick="startGame()">
      <span class="lock">🔒</span>
    </div>
    <h1>Ada sesuatu yang menantimu...</h1>
    <p>
      Sebuah petualangan kecil sudah disiapkan.<br>
      Lewati rintangan, temukan rahasia, dan sampai di ujung perjalanan!<br>
      <em>Seseorang meninggalkan ini khusus untukmu 💫</em>
    </p>
    <button class="overlay-btn" onclick="startGame()">🎮 Mulai Petualangan</button>
  </div>

  <!-- GAME OVER -->
  <div class="overlay" id="gameOverOverlay">
    <h1>💔 Yah, Coba Lagi!</h1>
    <p>Karakter kita kehabisan nyawa. Jangan menyerah, ayo coba lagi untuk sampai ke ujung!</p>
    <button class="overlay-btn" onclick="restartGame()">🔄 Coba Lagi</button>
  </div>

  <!-- PHOTO FOUND SCREEN -->
  <div class="overlay" id="photoFoundOverlay">
    <h1>📸 Rahasia Terungkap!</h1>
    <p>Kamu menemukan hadiah pertama di balik tembok rahasia!</p>
    <div class="birthday-photo-frame" id="photoFoundFrame"></div>
    <button class="overlay-btn" onclick="closePhotoFound()">Lanjut Petualangan →</button>
  </div>

  <!-- GIFT SURPRISE -->
  <div class="overlay" id="birthdayOverlay">
    <div class="birthday-content">
      <div class="birthday-gift" id="bdayGift">🎁</div>
      <div class="birthday-greeting">Selamat Ulang Tahun</div>
      <h1 class="birthday-name" id="bdayName">Sayangku 💖</h1>
      <div class="birthday-photo-frame" id="bdayPhotoFrame"></div>
      <div class="birthday-message" id="bdayMessage">
        Selamat ulang tahun, cintaku! 🎉
      </div>
      <div class="birthday-stats">
        <div class="stat-item">
          <div class="stat-value" id="finalCoins">0</div>
          <div class="stat-label">Koin</div>
        </div>
        <div class="stat-item">
          <div class="stat-value" id="finalTime">0s</div>
          <div class="stat-label">Waktu</div>
        </div>
        <div class="stat-item">
          <div class="stat-value" id="finalLives">3</div>
          <div class="stat-label">Nyawa</div>
        </div>
      </div>
      <button class="overlay-btn" onclick="showConfettiBurst()">🎉 Rayakan!</button>
      <button class="btn" style="margin-top:1rem; display:block; margin-left:auto; margin-right:auto;" onclick="restartGame()">🔄 Main Lagi</button>
    </div>
  </div>
</div>

<!-- Mobile Controls -->
<div class="mobile-controls">
  <div class="mobile-controls-left">
    <button class="mobile-btn" id="btnLeft" ontouchstart="mobileKey('left', true)" ontouchend="mobileKey('left', false)">◀</button>
    <button class="mobile-btn" id="btnRight" ontouchstart="mobileKey('right', true)" ontouchend="mobileKey('right', false)">▶</button>
  </div>
  <div class="mobile-controls-right">
    <button class="mobile-btn" id="btnJump" ontouchstart="mobileKey('jump', true)" ontouchend="mobileKey('jump', false)">⬆</button>
  </div>
</div>

<!-- EDIT BUTTON -->
<button class="edit-toggle" onclick="toggleEdit()" title="Edit">✏️</button>

<!-- EDIT PANEL -->
<div class="edit-panel" id="editPanel">
  <h3>✏️ Kustomisasi <button class="close-edit" onclick="toggleEdit()">✕</button></h3>

  <div class="form-section">
    <div class="form-section-title">🎁 Ucapan Spesial</div>
    <div class="form-group">
      <label>Nama Penerima</label>
      <input type="text" id="inputName" placeholder="Sayangku 💖">
    </div>
    <div class="form-group">
      <label>Pesan Ucapan</label>
      <textarea id="inputMessage" placeholder="Tulis pesan romantismu..."></textarea>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-title">📸 Foto Rahasia (di Balik Tembok)</div>
    <div class="form-group">
      <label>Upload Foto</label>
      <input type="file" id="inputPhoto" accept="image/*">
      <img id="photoPreview" class="photo-preview" alt="Preview">
      <div class="help-text">Foto ini akan muncul saat pemain menghancurkan tembok rahasia!</div>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-title">🌟 Cover Awal</div>
    <div class="form-group">
      <label>Judul Cover</label>
      <input type="text" id="inputCoverTitle" placeholder="Ada sesuatu yang menantimu...">
    </div>
    <div class="form-group">
      <label>Deskripsi Cover</label>
      <textarea id="inputCoverDesc" placeholder="Sebuah petualangan kecil..."></textarea>
    </div>
  </div>

  <div class="form-section">
    <div class="form-section-title">🎮 Level</div>
    <div class="form-group">
      <label>Jumlah Musuh (1-10)</label>
      <input type="number" id="inputEnemyCount" min="1" max="10" value="5">
    </div>
    <div class="form-group">
      <label>Jumlah Koin</label>
      <input type="number" id="inputCoinCount" min="10" max="60" value="34">
    </div>
  </div>

  <div class="form-section">
